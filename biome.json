{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "none",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "includes": ["test/fixtures/**"],
      "formatter": { "enabled": false },
      "assist": { "enabled": false },
      "linter": {
        "rules": {
          "a11y": "off",
          "correctness": { "noUnusedVariables": "off" }
        }
      }
    },
    {
      "includes": ["src/native/assets/**"],
      "linter": { "rules": { "a11y": "off" } }
    }
  ]
}
