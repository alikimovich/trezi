#!/usr/bin/env bun
/**
 * The agent-browser entry point inside Trezi provider helpers. A CLI daemon inherits
 * this private HOME/TMPDIR and can only launch the pinned headless-shell executable.
 * Never use the user's Chrome.app, Chrome profile, or existing agent-browser daemon.
 */
import { spawn, spawnSync } from 'node:child_process'
import { createHash } from 'node:crypto'
import { existsSync, lstatSync, mkdirSync, rmSync, writeFileSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'
// LOCAL-WEBKIT-4: the same detection Settings → Browser Checks shows (packaged beside this file).
import { BROWSER_TOOL_COMMANDS, findCli, findShell } from '../trezi-browser-tools.mjs'

const ownDir = dirname(fileURLToPath(import.meta.url))
const test = process.env.TREZI_BROWSER_TEST === '1'
// Exit 2: a refused route or policy (flags, session, command). Exit 3: a genuinely
// missing dependency (`dependency: vercel-cli`, `dependency: headless-shell`) that the
// user installs; never a PATH or launch-route problem, and no browser was launched.
const problem = (message) => {
  console.error(`Trezi agent-browser: ${message}`)
  process.exit(2)
}
const dependency = (kind, message) => {
  console.error(`Trezi agent-browser: dependency: ${kind}: ${message}`)
  process.exit(3)
}
const missingCli = () =>
  dependency(
    'vercel-cli',
    `the Vercel agent-browser CLI is not installed (install it in Trezi Settings → Browser Checks, or run: ${BROWSER_TOOL_COMMANDS.cli}). Trezi's managed wrapper is running correctly; do not reinstall a browser. No browser was launched.`
  )
const missingShell = () =>
  dependency(
    'headless-shell',
    `the dedicated Chromium headless shell is not installed (install it in Trezi Settings → Browser Checks, or run: ${BROWSER_TOOL_COMMANDS.shell}). The CLI was found and the managed route is working. No system Chrome fallback is allowed.`
  )

// The CLI is Trezi's own copy or the real Vercel one found outside this wrapper's own
// directory; the shell is the dedicated headless shell only (`trezi-browser-tools.mjs`).
const installedCli = () => findCli({ skip: [ownDir] })?.path ?? missingCli()
const headlessShell = () => findShell()?.path ?? missingShell()

const raw = process.argv.slice(2)
// A broken CLI that ignores TERM is killed outright at the limit (exit 1).
const passthroughMs = test && Number(process.env.TREZI_BROWSER_TEST_PASSTHROUGH_MS) > 0
  ? Number(process.env.TREZI_BROWSER_TEST_PASSTHROUGH_MS)
  : 10_000
const passthrough = { stdio: 'inherit', timeout: passthroughMs, killSignal: 'SIGKILL' }
if (raw.length === 1 && ['--help', '-h', '--version', '-V'].includes(raw[0])) {
  const result = spawnSync(installedCli(), raw, passthrough)
  process.exit(result.status ?? 1)
}
if (raw[0] === 'skills' && raw[1] === 'get') {
  const result = spawnSync(installedCli(), raw, passthrough)
  process.exit(result.status ?? 1)
}

// Reject options that could attach to another browser, start a headed window, or
// override the managed executable/config/profile. Batch/chat could hide those options.
const forbidden = new Set([
  '--headed', '--executable-path', '--profile', '--config', '--auto-connect', '--cdp',
  '--provider', '-p', '--engine', '--args', '--extension', '--session-name', '--state',
  '--', '--all'
])
for (const arg of raw) {
  const name = arg.split('=')[0]
  if (forbidden.has(name)) problem(`${name} is unavailable in Trezi's managed browser.`)
}
const sessionAt = raw.indexOf('--session')
const session = sessionAt < 0 ? '' : raw[sessionAt + 1]
if (!/^trezi-[a-zA-Z0-9_-]{1,80}$/.test(session ?? '') || raw.lastIndexOf('--session') !== sessionAt)
  problem('Pass one unique --session trezi-<task-id> on every browser command.')
const args = raw.filter((_, i) => i !== sessionAt && i !== sessionAt + 1)
const command = args[0]
const allowed = new Set([
  'open', 'click', 'dblclick', 'type', 'fill', 'press', 'keyboard', 'hover', 'focus',
  'check', 'uncheck', 'select', 'drag', 'upload', 'download', 'scroll',
  'scrollintoview', 'wait', 'screenshot', 'pdf', 'snapshot', 'close', 'back',
  'forward', 'reload', 'get', 'is', 'find', 'mouse', 'set', 'network', 'cookies',
  'storage', 'tab', 'diff', 'trace', 'profiler', 'record', 'console', 'errors',
  'highlight', 'session'
])
if (!allowed.has(command)) problem(`The ${command || 'missing'} command is unavailable in Trezi's managed browser.`)

const cli = installedCli()
const shell = headlessShell()
const digest = createHash('sha256').update(`${process.cwd()}\0${session}`).digest('hex').slice(0, 24)
const managedSession = `trezi-${digest.slice(0, 12)}`
const root = test && process.env.TREZI_BROWSER_TEST_ROOT
  ? process.env.TREZI_BROWSER_TEST_ROOT
  : '/tmp'
mkdirSync(root, { recursive: true, mode: 0o700 })
// The native CLI includes TMPDIR in its Unix socket name (macOS caps it at 103
// bytes). Keep the session's private base short even when launchd's TMPDIR is long.
const base = join(root, `tzab-${process.getuid?.() ?? 'user'}-${digest.slice(0, 12)}`)
mkdirSync(base, { recursive: true, mode: 0o700 })
const ownership = lstatSync(base)
if (ownership.isSymbolicLink() || ownership.uid !== process.getuid?.() || (ownership.mode & 0o077))
  problem('Private browser session directory is not owned by this user.')
const privateHome = join(base, 'h')
const privateTemp = join(base, 't')
const profile = join(base, 'p')
for (const dir of [privateHome, privateTemp, profile]) mkdirSync(dir, { recursive: true, mode: 0o700 })
const config = join(base, 'c.json')
if (!existsSync(config)) writeFileSync(config, '{}\n', { mode: 0o600 })
// Settings → Check Again: which CLI and shell this launch used and its private base, so
// the check confirms the fresh browser process itself (`src/main/browser-setup.ts`).
if (process.env.TREZI_BROWSER_SETUP_REPORT === '1' && command === 'open')
  console.error(`Trezi agent-browser: setup: ${JSON.stringify({ cli, shell, base })}`)
const env = { ...process.env }
for (const key of Object.keys(env)) {
  if (key.startsWith('AGENT_BROWSER_') && ![
    'AGENT_BROWSER_ALLOWED_DOMAINS', 'AGENT_BROWSER_ACTION_POLICY',
    'AGENT_BROWSER_CONFIRM_ACTIONS', 'AGENT_BROWSER_CONFIRM_INTERACTIVE'
  ].includes(key)) delete env[key]
}
Object.assign(env, {
  HOME: privateHome,
  TMPDIR: privateTemp,
  AGENT_BROWSER_CONFIG: config,
  AGENT_BROWSER_SESSION: managedSession,
  AGENT_BROWSER_EXECUTABLE_PATH: shell,
  AGENT_BROWSER_PROFILE: profile,
  AGENT_BROWSER_HEADED: 'false',
  AGENT_BROWSER_AUTO_CONNECT: 'false',
  AGENT_BROWSER_IDLE_TIMEOUT_MS: '120000'
})
const child = spawn(cli, [
  '--session', managedSession,
  '--config', config, '--executable-path', shell, '--profile', profile,
  '--headed', 'false', ...args
], { cwd: process.cwd(), env, stdio: 'inherit', timeout: 90_000, killSignal: 'SIGKILL' })
for (const signal of ['SIGINT', 'SIGTERM'])
  process.on(signal, () => child.kill(signal))
const result = await new Promise((resolve) => {
  child.once('error', (error) => resolve({ error }))
  child.once('close', (code, signal) => resolve({ code, signal }))
})
if (result.error) problem(result.error.message)
if (command === 'close' && result.code === 0) rmSync(base, { recursive: true, force: true })
process.exit(result.code ?? (result.signal === 'SIGTERM' ? 143 : 130))
